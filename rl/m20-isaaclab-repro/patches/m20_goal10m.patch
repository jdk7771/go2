+"""Episode-fixed waypoint command for the M20 goal-reaching task."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import torch
+
+from isaaclab.utils import configclass
+from rl_training.tasks.manager_based.locomotion.velocity.mdp.commands import (
+    UniformThresholdVelocityCommand,
+    UniformThresholdVelocityCommandCfg,
+)
+
+
+class FixedForwardGoalVelocityCommand(UniformThresholdVelocityCommand):
+    """Track a world waypoint 10 m in front of each episode's reset pose.
+
+    The actor still receives the same three body-frame velocity commands as the
+    baseline task. The target is fixed in world coordinates until that env resets.
+    """
+
+    cfg: FixedForwardGoalVelocityCommandCfg
+
+    def __init__(self, cfg: FixedForwardGoalVelocityCommandCfg, env):
+        super().__init__(cfg, env)
+        self.goal_pos_w = torch.zeros(self.num_envs, 2, device=self.device)
+
+    def _resample_command(self, env_ids: Sequence[int]):
+        if len(env_ids) == 0:
+            return
+        heading = self.robot.data.heading_w[env_ids]
+        forward_w = torch.stack((torch.cos(heading), torch.sin(heading)), dim=-1)
+        self.goal_pos_w[env_ids] = self.robot.data.root_pos_w[env_ids, :2] + self.cfg.goal_distance * forward_w
+        self.is_standing_env[env_ids] = False
+        self.is_heading_env[env_ids] = False
+        self._update_command()
+
+    def _update_command(self):
+        delta_w = self.goal_pos_w - self.robot.data.root_pos_w[:, :2]
+        distance = torch.linalg.vector_norm(delta_w, dim=-1)
+        heading = self.robot.data.heading_w
+        cos_heading = torch.cos(heading)
+        sin_heading = torch.sin(heading)
+
+        # Rotate the world-frame goal displacement into the current body frame.
+        delta_x_b = cos_heading * delta_w[:, 0] + sin_heading * delta_w[:, 1]
+        delta_y_b = -sin_heading * delta_w[:, 0] + cos_heading * delta_w[:, 1]
+        self.vel_command_b[:, 0] = torch.clamp(
+            self.cfg.position_gain * delta_x_b,
+            min=self.cfg.ranges.lin_vel_x[0],
+            max=self.cfg.ranges.lin_vel_x[1],
+        )
+        self.vel_command_b[:, 1] = torch.clamp(
+            self.cfg.position_gain * delta_y_b,
+            min=self.cfg.ranges.lin_vel_y[0],
+            max=self.cfg.ranges.lin_vel_y[1],
+        )
+        goal_heading = torch.atan2(delta_w[:, 1], delta_w[:, 0])
+        heading_error = torch.atan2(torch.sin(goal_heading - heading), torch.cos(goal_heading - heading))
+        self.vel_command_b[:, 2] = torch.clamp(
+            self.cfg.heading_control_stiffness * heading_error,
+            min=self.cfg.ranges.ang_vel_z[0],
+            max=self.cfg.ranges.ang_vel_z[1],
+        )
+        self.vel_command_b[distance <= self.cfg.goal_tolerance] = 0.0
+
+
+@configclass
+class FixedForwardGoalVelocityCommandCfg(UniformThresholdVelocityCommandCfg):
+    """Generate velocity commands toward an episode-fixed forward waypoint."""
+
+    class_type: type = FixedForwardGoalVelocityCommand
+
+    goal_distance: float = 10.0
+    goal_tolerance: float = 0.6
+    position_gain: float = 1.0
+
+
+def goal_reached(env, command_name: str, tolerance: float) -> torch.Tensor:
+    """Return whether the robot base is within tolerance of its fixed target."""
+    command = env.command_manager.get_term(command_name)
+    delta = command.goal_pos_w - env.scene["robot"].data.root_pos_w[:, :2]
+    return torch.linalg.vector_norm(delta, dim=-1) <= tolerance
+
+
+def goal_progress(env, command_name: str) -> torch.Tensor:
+    """Signed velocity toward the target, in m/s."""
+    command = env.command_manager.get_term(command_name)
+    robot = env.scene["robot"]
+    delta = command.goal_pos_w - robot.data.root_pos_w[:, :2]
+    direction = delta / torch.clamp(torch.linalg.vector_norm(delta, dim=-1, keepdim=True), min=1e-6)
+    progress = torch.sum(robot.data.root_lin_vel_w[:, :2] * direction, dim=-1)
+    return torch.where(goal_reached(env, command_name, command.cfg.goal_tolerance), 0.0, progress)
