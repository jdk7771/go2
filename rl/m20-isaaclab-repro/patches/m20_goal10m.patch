+"""M20 waypoint task: reach a point 10 m ahead across taller rough terrain."""
+
+from isaaclab.managers import RewardTermCfg as RewTerm
+from isaaclab.managers import TerminationTermCfg as DoneTerm
+from isaaclab.utils import configclass
+
+from rl_training.tasks.manager_based.locomotion.velocity.config.wheeled.deeprobotics_m20.goal_command import (
+    FixedForwardGoalVelocityCommandCfg,
+    goal_progress,
+    goal_reached,
+)
+from rl_training.tasks.manager_based.locomotion.velocity.config.wheeled.deeprobotics_m20.rough_env_cfg import (
+    DeeproboticsM20RewardsCfg,
+    DeeproboticsM20RoughEnvCfg,
+)
+from rl_training.tasks.manager_based.locomotion.velocity.velocity_env_cfg import TerminationsCfg
+
+
+@configclass
+class DeeproboticsM20GoalRewardsCfg(DeeproboticsM20RewardsCfg):
+    goal_progress = RewTerm(func=goal_progress, weight=2.0, params={"command_name": "base_velocity"})
+    goal_reached = RewTerm(
+        func=goal_reached,
+        weight=250.0,
+        params={"command_name": "base_velocity", "tolerance": 0.6},
+    )
+
+
+@configclass
+class DeeproboticsM20GoalTerminationsCfg(TerminationsCfg):
+    goal_reached = DoneTerm(
+        func=goal_reached,
+        params={"command_name": "base_velocity", "tolerance": 0.6},
+    )
+
+
+@configclass
+class DeeproboticsM20GoalEnvCfg(DeeproboticsM20RoughEnvCfg):
+    """Keep the baseline controller interface while replacing its command source."""
+
+    rewards: DeeproboticsM20GoalRewardsCfg = DeeproboticsM20GoalRewardsCfg()
+    terminations: DeeproboticsM20GoalTerminationsCfg = DeeproboticsM20GoalTerminationsCfg()
+
+    def __post_init__(self):
+        super().__post_init__()
+
+        self.commands.base_velocity = FixedForwardGoalVelocityCommandCfg(
+            asset_name="robot",
+            resampling_time_range=(60.0, 60.0),
+            heading_command=False,
+            heading_control_stiffness=1.5,
+            rel_standing_envs=0.0,
+            debug_vis=False,
+            ranges=FixedForwardGoalVelocityCommandCfg.Ranges(
+                lin_vel_x=(-1.5, 1.5),
+                lin_vel_y=(-1.0, 1.0),
+                ang_vel_z=(-1.5, 1.5),
+            ),
+            goal_distance=10.0,
+            goal_tolerance=0.6,
+            position_gain=1.0,
+        )
+
+        terrain = self.scene.terrain.terrain_generator.sub_terrains
+        # Retain easy curriculum levels, but expose 32 cm steps at the hard end.
+        terrain["pyramid_stairs"].step_height_range = (0.05, 0.32)
+        terrain["pyramid_stairs_inv"].step_height_range = (0.05, 0.32)
+        terrain["pyramid_stairs"].proportion = 0.25
+        terrain["pyramid_stairs_inv"].proportion = 0.25
+        terrain["boxes"].grid_height_range = (0.025, 0.25)
+        terrain["hf_pyramid_slope"].proportion = 0.05
+        terrain["hf_pyramid_slope_inv"].proportion = 0.05
+
+        # The waypoint is fixed for a whole episode; 10 m at <= 1.5 m/s fits in 20 s.
+        # Keep the historical velocity task and its checkpoints untouched.
+        self.disable_zero_weight_rewards()
