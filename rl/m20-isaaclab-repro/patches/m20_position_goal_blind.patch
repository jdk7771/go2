@@ -0,0 +1,61 @@
+"""M20 environment with auditable physics-step speed monitoring."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import torch
+
+from isaaclab.envs import ManagerBasedRLEnv
+
+
+class M20PositionGoalSafetyEnv(ManagerBasedRLEnv):
+    """Collect safety and success state at every 5 ms simulation step.
+
+    Isaac Lab calls :meth:`_on_physics_step` from inside its decimation loop;
+    the small hook is supplied by the companion IsaacLab patch.
+    """
+
+    def __init__(self, cfg, render_mode: str | None = None, **kwargs):
+        super().__init__(cfg, render_mode=render_mode, **kwargs)
+        self.physics_max_speed = torch.zeros(self.num_envs, device=self.device)
+        self.physics_speed_violation = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
+        self.goal_stable = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
+        self._goal_stable_time = torch.zeros(self.num_envs, device=self.device)
+        self._shield_intervention_steps = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
+
+    def _on_physics_step(self):
+        robot = self.scene["robot"]
+        speed = torch.linalg.vector_norm(robot.data.root_lin_vel_w, dim=-1)
+        self.physics_max_speed = torch.maximum(self.physics_max_speed, speed)
+        self.physics_speed_violation |= speed > 0.80
+
+        if "position_goal" not in self.command_manager.active_terms:
+            return
+        command = self.command_manager.get_term("position_goal")
+        distance = command.goal_distance()
+        stable = (distance < 0.35) & (speed < 0.15)
+        self._goal_stable_time = torch.where(stable, self._goal_stable_time + self.physics_dt, 0.0)
+        self.goal_stable |= self._goal_stable_time >= 0.5
+
+    def record_shield_intervention(self, intervene: torch.Tensor):
+        self._shield_intervention_steps += intervene.to(torch.long)
+
+    def _reset_idx(self, env_ids: Sequence[int]):
+        if not hasattr(self, "physics_max_speed"):
+            return super()._reset_idx(env_ids)
+        max_speed = self.physics_max_speed[env_ids].clone()
+        violations = self.physics_speed_violation[env_ids].float().clone()
+        shield_steps = self._shield_intervention_steps[env_ids].float().clone()
+        super()._reset_idx(env_ids)
+        self.extras["log"].update({
+            "Episode/max_speed_3d": max_speed.mean().item(),
+            "Episode/speed_violation_rate": violations.mean().item(),
+            "Episode/shield_intervention_count": shield_steps.mean().item(),
+            "Episode/shield_intervention_duration_s": (shield_steps * self.physics_dt).mean().item(),
+        })
+        self.physics_max_speed[env_ids] = 0.0
+        self.physics_speed_violation[env_ids] = False
+        self.goal_stable[env_ids] = False
+        self._goal_stable_time[env_ids] = 0.0
+        self._shield_intervention_steps[env_ids] = 0
