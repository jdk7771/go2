+"""Independent 6 m blind position-goal PPO task for the DeepRobotics M20."""
+
+from __future__ import annotations
+
+import isaaclab.terrains as terrain_gen
+from isaaclab.managers import RewardTermCfg as RewTerm
+from isaaclab.managers import TerminationTermCfg as DoneTerm
+from isaaclab.utils import configclass
+
+import rl_training.tasks.manager_based.locomotion.velocity.mdp as mdp
+from rl_training.tasks.manager_based.locomotion.velocity.config.wheeled.deeprobotics_m20.position_goal import (
+    FixedForwardPositionGoalCommandCfg,
+    goal_progress,
+    goal_reached_stably,
+    relative_goal_position,
+    speed_penalty,
+    speed_violation,
+)
+from rl_training.tasks.manager_based.locomotion.velocity.config.wheeled.deeprobotics_m20.rough_env_cfg import (
+    DeeproboticsM20ActionsCfg,
+    DeeproboticsM20RewardsCfg,
+    DeeproboticsM20RoughEnvCfg,
+)
+from rl_training.tasks.manager_based.locomotion.velocity.mdp.position_goal_safety import (
+    SpeedShieldedJointVelocityActionCfg,
+)
+from rl_training.tasks.manager_based.locomotion.velocity.position_goal_env import M20PositionGoalSafetyEnv
+from rl_training.tasks.manager_based.locomotion.velocity.velocity_env_cfg import TerminationsCfg
+
+
+@configclass
+class M20PositionGoalActionsCfg(DeeproboticsM20ActionsCfg):
+    """Keep the 12+4 action layout while shielding wheel targets above 0.75 m/s."""
+
+    joint_vel = SpeedShieldedJointVelocityActionCfg(
+        asset_name="robot", joint_names=[""], scale=5.0, use_default_offset=True, clip=None, preserve_order=True,
+        warning_speed=0.75,
+    )
+
+
+@configclass
+class M20PositionGoalRewardsCfg(DeeproboticsM20RewardsCfg):
+    goal_progress = RewTerm(func=goal_progress, weight=1.0)
+    speed_buffer = RewTerm(func=speed_penalty, weight=-8.0, params={"threshold": 0.65})
+    speed_warning = RewTerm(func=speed_penalty, weight=-80.0, params={"threshold": 0.75})
+    goal_success = RewTerm(func=goal_reached_stably, weight=5000.0)
+    speed_violation = RewTerm(func=speed_violation, weight=-2500.0)
+
+
+@configclass
+class M20PositionGoalTerminationsCfg(TerminationsCfg):
+    goal_success = DoneTerm(func=goal_reached_stably)
+    speed_violation = DoneTerm(func=speed_violation)
+
+
+@configclass
+class DeeproboticsM20PositionGoalBlindEnvCfg(DeeproboticsM20RoughEnvCfg):
+    """First-experiment task: phase-1 terrain mix and direct 2-D goal observation."""
+
+    actions: M20PositionGoalActionsCfg = M20PositionGoalActionsCfg()
+    rewards: M20PositionGoalRewardsCfg = M20PositionGoalRewardsCfg()
+    terminations: M20PositionGoalTerminationsCfg = M20PositionGoalTerminationsCfg()
+
+    def __post_init__(self):
+        super().__post_init__()
+        self.episode_length_s = 30.0
+
+        # Position-goal command: never expose or train against a velocity command.
+        self.commands.base_velocity = None
+        self.commands.position_goal = FixedForwardPositionGoalCommandCfg(
+            asset_name="robot", resampling_time_range=(31.0, 31.0), debug_vis=False, goal_distance=6.0
+        )
+
+        # Actor: 3 angular velocity + 3 gravity + 2 goal + 16 q + 16 qd + 16 action = 56.
+        # Critic adds only 3-D true linear velocity, for a 59-D privileged state.
+        self.observations.policy.velocity_commands.func = relative_goal_position
+        self.observations.policy.velocity_commands.params = {"command_name": "position_goal"}
+        self.observations.policy.base_lin_vel = None
+        self.observations.policy.height_scan = None
+        self.observations.critic.velocity_commands.func = relative_goal_position
+        self.observations.critic.velocity_commands.params = {"command_name": "position_goal"}
+        self.observations.critic.height_scan = None
+
+        # Phase 1 mixture: flat / regular stairs / a square ledge.  The first run deliberately
+        # uses only low obstacles; higher curriculum stages require evidence from this run.
+        generator = self.scene.terrain.terrain_generator
+        generator.size = (12.0, 8.0)
+        generator.sub_terrains = {
+            "flat": terrain_gen.MeshPlaneTerrainCfg(proportion=0.50),
+            "stairs": terrain_gen.MeshPyramidStairsTerrainCfg(
+                proportion=0.35, step_height_range=(0.03, 0.08), step_width=0.50,
+                platform_width=3.0, border_width=1.0, holes=False,
+            ),
+            "ledge": terrain_gen.MeshBoxTerrainCfg(
+                proportion=0.15, box_height_range=(0.05, 0.08), platform_width=3.0, double_box=False,
+            ),
+        }
+        self.scene.terrain.max_init_terrain_level = 0
+        self.curriculum.terrain_levels = None
+        self.curriculum.gait_level = None
+        self.curriculum.command_levels = None
+
+        # Reset in a controlled state; random pushes would confound a speed-limit experiment.
+        self.events.randomize_reset_base.params["pose_range"] = {
+            "x": (-0.20, 0.20), "y": (-0.20, 0.20), "z": (0.0, 0.0),
+            "roll": (0.0, 0.0), "pitch": (0.0, 0.0), "yaw": (-0.10, 0.10),
+        }
+        self.events.randomize_reset_base.params["velocity_range"] = {
+            "x": (0.0, 0.0), "y": (0.0, 0.0), "z": (0.0, 0.0),
+            "roll": (0.0, 0.0), "pitch": (0.0, 0.0), "yaw": (0.0, 0.0),
+        }
+        self.events.randomize_push_robot = None
+
+        # Remove rewards tied to the old velocity-command task or its gait template.
+        for name in (
+            "track_lin_vel_xy_exp", "track_ang_vel_z_exp", "stand_still", "hipx_joint_pos_penalty",
+            "hipy_joint_pos_penalty", "knee_joint_pos_penalty", "feet_air_time_ang_z_M20",
+            "feet_slide_ang_z_cmd", "rotation_gait_status", "rotation_gait_symmetry",
+        ):
+            if hasattr(self.rewards, name):
+                setattr(self.rewards, name, None)
+        self.rewards.is_terminated.weight = 0.0
+        # The parent helper assumes every attribute is a reward term.  This
+        # local variant also tolerates terms explicitly disabled above.
+        for name in dir(self.rewards):
+            term = getattr(self.rewards, name)
+            if term is not None and hasattr(term, "weight") and term.weight == 0.0:
+                setattr(self.rewards, name, None)
+
+        # Termination is a failure, not a timeout, so PPO does not bootstrap a speed violation.
+        self.terminations.terrain_out_of_bounds.time_out = False
+        self.terminations.speed_violation.time_out = False
+        self.terminations.goal_success.time_out = False
+
+
+M20PositionGoalBlindEnv = M20PositionGoalSafetyEnv
