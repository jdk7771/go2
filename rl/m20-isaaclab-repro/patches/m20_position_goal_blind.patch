+"""Action-side speed safety supervisor for the M20 blind goal task."""
+
+from __future__ import annotations
+
+import torch
+
+from isaaclab.envs.mdp.actions import JointVelocityAction, JointVelocityActionCfg
+from isaaclab.utils import configclass
+
+
+class SpeedShieldedJointVelocityAction(JointVelocityAction):
+    """Set wheel velocity targets to zero while the measured 3-D base speed is unsafe."""
+
+    cfg: "SpeedShieldedJointVelocityActionCfg"
+
+    def apply_actions(self):
+        speed = torch.linalg.vector_norm(self._asset.data.root_lin_vel_w, dim=-1)
+        intervene = speed >= self.cfg.warning_speed
+        targets = self.processed_actions.clone()
+        targets[intervene] = 0.0
+        self._asset.set_joint_velocity_target(targets, joint_ids=self._joint_ids)
+        if hasattr(self._env, "record_shield_intervention"):
+            self._env.record_shield_intervention(intervene)
+
+
+@configclass
+class SpeedShieldedJointVelocityActionCfg(JointVelocityActionCfg):
+    class_type: type = SpeedShieldedJointVelocityAction
+    warning_speed: float = 0.75
