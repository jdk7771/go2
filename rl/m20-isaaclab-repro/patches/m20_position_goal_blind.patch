+"""Building blocks for the M20 blind position-goal baseline.
+
+The task deliberately exposes only a normalized body-frame goal vector to the
+actor.  It does not convert a position goal into a hidden velocity command.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import torch
+
+from isaaclab.managers import CommandTerm, CommandTermCfg
+from isaaclab.utils import configclass
+
+
+class FixedForwardPositionGoalCommand(CommandTerm):
+    """Keep a 2-D world goal six metres ahead of the reset pose for one episode."""
+
+    cfg: "FixedForwardPositionGoalCommandCfg"
+
+    def __init__(self, cfg: "FixedForwardPositionGoalCommandCfg", env):
+        super().__init__(cfg, env)
+        self.robot = env.scene[cfg.asset_name]
+        self.goal_pos_w = torch.zeros(self.num_envs, 2, device=self.device)
+        self.previous_distance = torch.zeros(self.num_envs, device=self.device)
+        self._command = torch.zeros(self.num_envs, 2, device=self.device)
+
+    @property
+    def command(self) -> torch.Tensor:
+        """Normalized, current-yaw body-frame relative goal used by observations."""
+        return self._command
+
+    def _resample_command(self, env_ids: Sequence[int]):
+        if len(env_ids) == 0:
+            return
+        heading = self.robot.data.heading_w[env_ids]
+        forward_w = torch.stack((torch.cos(heading), torch.sin(heading)), dim=-1)
+        start_xy = self.robot.data.root_pos_w[env_ids, :2]
+        self.goal_pos_w[env_ids] = start_xy + self.cfg.goal_distance * forward_w
+        self.previous_distance[env_ids] = self.cfg.goal_distance
+
+    def _update_command(self):
+        delta_w = self.goal_pos_w - self.robot.data.root_pos_w[:, :2]
+        heading = self.robot.data.heading_w
+        cos_heading = torch.cos(heading)
+        sin_heading = torch.sin(heading)
+        self._command[:, 0] = (cos_heading * delta_w[:, 0] + sin_heading * delta_w[:, 1]) / self.cfg.goal_distance
+        self._command[:, 1] = (-sin_heading * delta_w[:, 0] + cos_heading * delta_w[:, 1]) / self.cfg.goal_distance
+
+    def _update_metrics(self):
+        # Episode metrics are gathered by the environment's 200 Hz safety monitor.
+        pass
+
+    def goal_distance(self) -> torch.Tensor:
+        return torch.linalg.vector_norm(self.goal_pos_w - self.robot.data.root_pos_w[:, :2], dim=-1)
+
+    def consume_progress(self, step_dt: float) -> torch.Tensor:
+        """Return distance reduction per second once, then advance the reference."""
+        current_distance = self.goal_distance()
+        progress_per_second = (self.previous_distance - current_distance) / step_dt
+        self.previous_distance.copy_(current_distance)
+        return progress_per_second
+
+
+@configclass
+class FixedForwardPositionGoalCommandCfg(CommandTermCfg):
+    class_type: type = FixedForwardPositionGoalCommand
+
+    asset_name: str = "robot"
+    goal_distance: float = 6.0
+
+
+def relative_goal_position(env, command_name: str = "position_goal") -> torch.Tensor:
+    """Return the two normalized body-frame goal coordinates."""
+    return env.command_manager.get_command(command_name)
+
+
+def goal_progress(env, command_name: str = "position_goal") -> torch.Tensor:
+    """Distance reduction in metres/second, integrated once by RewardManager."""
+    return env.command_manager.get_term(command_name).consume_progress(env.step_dt)
+
+
+def speed_penalty(env, threshold: float) -> torch.Tensor:
+    """Squared excess of real world-frame 3-D base speed above ``threshold``."""
+    speed = torch.linalg.vector_norm(env.scene["robot"].data.root_lin_vel_w, dim=-1)
+    return torch.square(torch.clamp(speed - threshold, min=0.0))
+
+
+def speed_violation(env) -> torch.Tensor:
+    """True when any 5 ms physics sample in this control step exceeded 0.8 m/s."""
+    return env.physics_speed_violation
+
+
+def goal_reached_stably(env) -> torch.Tensor:
+    """True after the goal and low-speed conditions held for the configured dwell time."""
+    return env.goal_stable
