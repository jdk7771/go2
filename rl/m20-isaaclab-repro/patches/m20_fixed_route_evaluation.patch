+"""Route terrains used by the M20 six-metre position-goal experiment.
+
+Every tile has the same semantic layout: the robot starts on level ground,
+the 6 m XY goal lies on a valid support surface (ground, a stair tread, or a
+raised platform), and any obstacle is placed on the direct route.  This is deliberately different from
+the generic Isaac Lab pyramid/box terrains, whose spawn point and obstacle
+layout do not encode this experiment's task.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import trimesh
+
+from isaaclab.terrains.sub_terrain_cfg import SubTerrainBaseCfg
+from isaaclab.utils import configclass
+
+
+@configclass
+class PositionGoalRouteTerrainCfg(SubTerrainBaseCfg):
+    """A flat, stair, or single-ledge route with a controlled start and goal."""
+
+    function = None
+    terrain_type: str = "flat"  # ``flat``, ``stairs``, or ``ledge``.
+    route_start_x: float = 2.0
+    goal_distance: float = 6.0
+    route_width: float = 3.0
+    obstacle_distance_range: tuple[float, float] = (2.0, 4.0)
+    obstacle_height_range: tuple[float, float] = (0.05, 0.05)
+    stair_count: int = 3
+    stair_tread_depth: float = 0.50
+
+
+def _box(size: tuple[float, float, float], center: tuple[float, float, float]) -> trimesh.Trimesh:
+    """Make an axis-aligned, collision-ready box mesh."""
+    return trimesh.creation.box(size, trimesh.transformations.translation_matrix(center))
+
+
+def position_goal_route_terrain(
+    difficulty: float, cfg: PositionGoalRouteTerrainCfg
+) -> tuple[list[trimesh.Trimesh], np.ndarray]:
+    """Generate a route whose terrain origin is the robot's level start pose.
+
+    ``difficulty`` provides bounded variation for training only: it changes the
+    obstacle's position and height within the configuration ranges.  Fixed
+    evaluation scenarios set both ends of every range to the same value.
+    """
+    size_x, size_y = cfg.size
+    start_x = cfg.route_start_x
+    goal_x = start_x + cfg.goal_distance
+    if not 0.0 < start_x < goal_x < size_x:
+        raise ValueError("Route start and 6 m goal must lie inside the terrain tile.")
+
+    obstacle_distance = cfg.obstacle_distance_range[0] + difficulty * (
+        cfg.obstacle_distance_range[1] - cfg.obstacle_distance_range[0]
+    )
+    obstacle_x = start_x + obstacle_distance
+    if not start_x < obstacle_x < goal_x:
+        raise ValueError("Obstacle must be between the route start and the 6 m goal.")
+    height = cfg.obstacle_height_range[0] + difficulty * (
+        cfg.obstacle_height_range[1] - cfg.obstacle_height_range[0]
+    )
+
+    # A solid base gives every route a level floor at z=0.  Raised boxes add
+    # only the directed obstacle and its landing platform.
+    meshes: list[trimesh.Trimesh] = [_box((size_x, size_y, 1.0), (size_x / 2.0, size_y / 2.0, -0.5))]
+    if cfg.terrain_type == "flat":
+        return meshes, np.array([start_x, size_y / 2.0, 0.0])
+
+    route_min_y = (size_y - cfg.route_width) / 2.0
+    route_max_y = (size_y + cfg.route_width) / 2.0
+    route_center_y = (route_min_y + route_max_y) / 2.0
+
+    if cfg.terrain_type == "stairs":
+        stair_end_x = obstacle_x + cfg.stair_count * cfg.stair_tread_depth
+        if stair_end_x >= size_x:
+            raise ValueError("The stair route must fit inside the terrain tile.")
+        for step in range(cfg.stair_count):
+            step_height = height * (step + 1)
+            step_center_x = obstacle_x + (step + 0.5) * cfg.stair_tread_depth
+            meshes.append(
+                _box((cfg.stair_tread_depth, cfg.route_width, step_height),
+                     (step_center_x, route_center_y, step_height / 2.0))
+            )
+        landing_height = height * cfg.stair_count
+        landing_width = size_x - stair_end_x
+        meshes.append(
+            _box((landing_width, cfg.route_width, landing_height),
+                 (stair_end_x + landing_width / 2.0, route_center_y, landing_height / 2.0))
+        )
+    elif cfg.terrain_type == "ledge":
+        landing_width = size_x - obstacle_x
+        meshes.append(
+            _box((landing_width, cfg.route_width, height),
+                 (obstacle_x + landing_width / 2.0, route_center_y, height / 2.0))
+        )
+    else:
+        raise ValueError(f"Unknown position-goal terrain type: {cfg.terrain_type}")
+
+    # The origin determines where Isaac Lab resets this environment.  Keep it
+    # at the route start rather than at the terrain centre.
+    return meshes, np.array([start_x, size_y / 2.0, 0.0])
+
+
+PositionGoalRouteTerrainCfg.function = position_goal_route_terrain
+
+
+@dataclass(frozen=True)
+class FixedEvaluationScenario:
+    test_id: str
+    terrain_type: str
+    obstacle_height: float = 0.0
+    stair_count: int = 0
+    label: str = ""
+
+
+# Geometry version 1.0.  All scenarios use start x=2.0 m, goal x=8.0 m,
+# obstacle leading edge x=4.5 m, 3 m route width, and a 14 m x 8 m tile.
+# Goal support is scenario-defined; the current stairs end in a top platform,
+# while the ledge tests place the goal directly on the raised platform.
+FIXED_EVALUATION_SCENARIOS: dict[str, FixedEvaluationScenario] = {
+    "T01": FixedEvaluationScenario("T01", "flat", label="flat_6m"),
+    "T02": FixedEvaluationScenario("T02", "stairs", 0.05, 3, "stairs_0p05m"),
+    "T03": FixedEvaluationScenario("T03", "stairs", 0.10, 3, "stairs_0p10m"),
+    "T04": FixedEvaluationScenario("T04", "stairs", 0.15, 3, "stairs_0p15m"),
+    "T05": FixedEvaluationScenario("T05", "ledge", 0.05, label="ledge_0p05m"),
+    "T06": FixedEvaluationScenario("T06", "ledge", 0.10, label="ledge_0p10m"),
+    "T07": FixedEvaluationScenario("T07", "ledge", 0.15, label="ledge_0p15m"),
+    "T08": FixedEvaluationScenario("T08", "ledge", 0.20, label="ledge_0p20m"),
+}
+
+
+def configure_fixed_evaluation_terrain(env_cfg, test_id: str) -> FixedEvaluationScenario:
+    """Replace a task terrain mix with one deterministic, versioned test route."""
+    scenario = FIXED_EVALUATION_SCENARIOS[test_id]
+    generator = env_cfg.scene.terrain.terrain_generator
+    generator.size = (14.0, 8.0)
+    generator.num_rows = 1
+    generator.num_cols = 1
+    generator.curriculum = False
+    generator.seed = 20261009
+    generator.sub_terrains = {
+        scenario.test_id: PositionGoalRouteTerrainCfg(
+            function=position_goal_route_terrain,
+            proportion=1.0,
+            terrain_type=scenario.terrain_type,
+            route_start_x=2.0,
+            goal_distance=6.0,
+            route_width=3.0,
+            obstacle_distance_range=(2.5, 2.5),
+            obstacle_height_range=(scenario.obstacle_height, scenario.obstacle_height),
+            stair_count=scenario.stair_count,
+            stair_tread_depth=0.50,
+        )
+    }
+    env_cfg.scene.terrain.max_init_terrain_level = 0
+    return scenario
